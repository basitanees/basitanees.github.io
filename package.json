    "d3-selection": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12"
  },
