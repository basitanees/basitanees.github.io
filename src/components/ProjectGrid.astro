---
import ProjectCard from './ProjectCard.astro';
import type { P } from '../lib/projects';

interface Props {
  projects: P[];
}
const { projects } = Astro.props;
---
<div class="grid">
  {projects.map((p, i) => <ProjectCard project={p} rank={i + 1} />)}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 400px), 1fr));
    gap: 16px;
  }
</style>
