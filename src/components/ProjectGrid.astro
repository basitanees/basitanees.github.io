---
import ProjectCard from './ProjectCard.astro';
import type { P } from '../lib/projects';

interface Props {
  projects: P[];
}
const { projects } = Astro.props;
---
<div class="grid">
  {projects.map((p, i) => <ProjectCard project={p} rank={i + 1} />)}
</div>

<style>
  .grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
</style>
