---
import { areaLabel, type AreaId } from '../data/areas';

interface Props {
  areas: AreaId[];
  small?: boolean;
}
const { areas, small = false } = Astro.props;
---
{
  areas.length > 0 && (
    <ul class:list={['chips', { small }]}>
      {areas.map((id) => (
        <li>
          <a class="chip glass" href={`/areas/${id}/`}>
            {areaLabel(id)}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    display: inline-block;
    padding: 6px 13px;
    border-radius: 999px;
    color: var(--text);
    font-size: 13px;
  }
  .chip:hover {
    text-decoration: none;
    background: var(--hov);
  }
  .small .chip {
    padding: 3px 10px;
    font-size: 11.5px;
  }
</style>
