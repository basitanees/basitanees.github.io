---
import { areaLabel, type AreaId } from '../data/areas';

interface Props {
  areas: AreaId[];
  small?: boolean;
}
const { areas, small = false } = Astro.props;
---
{
  areas.length > 0 && (
    <ul class:list={['areas', { small }]}>
      {areas.map((id) => (
        <li>
          <a href={`/areas/${id}/`}>{areaLabel(id)}</a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  a {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid var(--line);
    color: var(--text-2);
    font-size: 13px;
    transition: color var(--fast) var(--ease), border-color var(--fast) var(--ease);
  }
  a:hover {
    color: var(--text);
    border-color: var(--line-strong);
    text-decoration: none;
  }
  .small {
    gap: 4px 12px;
  }
  .small a {
    padding: 0;
    border: 0;
    font-size: 13px;
    color: var(--muted);
  }
  .small a:hover {
    color: var(--text);
    text-decoration: underline;
  }
</style>
