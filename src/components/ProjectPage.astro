---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import AreaChips from './AreaChips.astro';
import { formatDates } from '../lib/projects';

interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { title, org, role, start, end, summary, areas, links, section } = entry.data;
const { Content } = await render(entry);
const meta = [role, formatDates(start, end)].filter(Boolean).join(' · ');
---
<Base title={title} description={summary} current={section}>
  <article class="wrap page">
    <p><a href={`/${section}/`}>← {section === 'work' ? 'Work' : 'Research'}</a></p>
    {org && <p class="eyebrow">{org}</p>}
    <h1>{title}</h1>
    <p class="meta muted">{meta}</p>
    <p class="lead">{summary}</p>
    <AreaChips areas={areas} />
    {
      links.length > 0 && (
        <p class="links">
          {links.map((l) => (
            <a href={l.href}>{l.label} ↗</a>
          ))}
        </p>
      )
    }
    <div class="body glass prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .page {
    max-width: 820px;
  }
  h1 {
    font-size: clamp(30px, 5vw, 44px);
    margin: 6px 0 4px;
  }
  .meta {
    margin: 0 0 14px;
    font-size: 14px;
  }
  .lead {
    font-size: 18px;
    margin: 0 0 16px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 16px 0;
  }
  .body {
    margin-top: 20px;
    border-radius: var(--radius);
    padding: 8px 26px 18px;
  }
</style>
