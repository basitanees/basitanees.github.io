---
import { ASK } from '../../data/ask';
import Icon from '../Icon.astro';
---
<div class="ask">
  <div class="field" aria-hidden="true"><Icon name="search" /><span>Ask about my work</span></div>
  <fieldset class="qa">
    <legend class="sr-only">Pick a question</legend>
    {
      ASK.map((item, i) => (
        <>
          <input class="sr-only" type="radio" name="ask" id={`ask-${i + 1}`} checked={i === 0} />
          <label class="chip" for={`ask-${i + 1}`}>
            {item.question}
          </label>
          <div class="answer" aria-live="polite">
            <span class="rank">01</span>
            <div>
              <p>{item.answer}</p>
              <a href={item.href}>
                {item.linkLabel} <Icon name="arrow-right" size={14} />
              </a>
            </div>
          </div>
        </>
      ))
    }
  </fieldset>
</div>

<style>
  .ask {
    padding: 24px;
  }
  .field {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 16px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--raised);
    color: var(--muted);
    font-size: 15px;
  }
  .qa {
    border: 0;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    font-size: 13px;
    line-height: 20px;
    padding: 6px 10px;
    border-radius: 8px;
    border: 1px solid var(--line);
    color: var(--text-2);
    cursor: pointer;
    transition: color var(--fast) var(--ease), border-color var(--fast) var(--ease), background-color var(--fast) var(--ease);
  }
  .chip:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }
  input:checked + .chip {
    color: var(--text);
    border-color: var(--line-strong);
    background: var(--raised);
  }
  input:focus-visible + .chip {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .answer {
    display: none;
    order: 1;
    flex-basis: 100%;
    gap: 12px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .answer .rank {
    padding-top: 3px;
  }
  .answer p {
    margin: 0 0 8px;
    font-size: 15px;
    line-height: 1.6;
  }
  .answer a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
  }
  input:checked + .chip + .answer {
    display: flex;
  }
</style>
