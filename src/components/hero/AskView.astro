---
import { ASK } from '../../data/ask';
---
<div class="ask">
  <div class="bar glass" aria-hidden="true"><span>⌕</span><span class="ph">Ask about my work</span></div>
  <fieldset class="qa">
    <legend class="sr-only">Pick a question</legend>
    {
      ASK.map((item, i) => (
        <>
          <input class="sr-only" type="radio" name="ask" id={`ask-${i + 1}`} checked={i === 0} />
          <label class="chip glass" for={`ask-${i + 1}`}>{item.question}</label>
          <div class="answer glass" aria-live="polite">
            <p>{item.answer}</p>
            <a href={item.href}>{item.linkLabel} →</a>
          </div>
        </>
      ))
    }
  </fieldset>
</div>

<style>
  .ask {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 26px 20px;
  }
  .bar {
    width: min(540px, 100%);
    border-radius: 14px;
    padding: 12px 16px;
    font-size: 16px;
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .ph {
    color: var(--muted);
    border-right: 2px solid var(--accent);
    padding-right: 3px;
    animation: blink 0.9s step-end infinite;
  }
  @keyframes blink {
    50% {
      border-color: transparent;
    }
  }
  .qa {
    border: 0;
    margin: 14px 0 0;
    padding: 0;
    width: min(640px, 100%);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .chip {
    font-size: 13px;
    padding: 7px 13px;
    border-radius: 999px;
    cursor: pointer;
  }
  .chip:hover {
    background: var(--hov);
  }
  input:checked + .chip {
    background: var(--seg);
    font-weight: 600;
  }
  input:focus-visible + .chip {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .answer {
    display: none;
    order: 1;
    flex-basis: 100%;
    margin-top: 6px;
    border-radius: 14px;
    padding: 14px 18px;
    font-size: 14.5px;
  }
  .answer p {
    margin: 0 0 6px;
  }
  input:checked + .chip + .answer {
    display: block;
  }
</style>
