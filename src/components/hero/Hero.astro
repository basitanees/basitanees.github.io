---
import { SITE } from '../../data/site';
import Icon from '../Icon.astro';
import MapView from './MapView.astro';
import AskView from './AskView.astro';
import ReelView from './ReelView.astro';

const VIEWS = [
  { id: 'map', label: 'Map' },
  { id: 'ask', label: 'Ask' },
  { id: 'reel', label: 'Reel' },
];
---
<section class="hero wrap">
  <div class="text">
    <h1>{SITE.name}</h1>
    <p class="headline">{SITE.headline}</p>
    <p class="intro">
      I build the retrieval and agent systems that LLMs read from and act through, and I benchmark every retrieval change before it ships. My research is on
      generative models, published at SIGGRAPH Asia and in ACM Transactions on Graphics.
    </p>
    <p class="actions">
      <a class="button button-primary" href="/work/">View work <Icon name="arrow-right" /></a>
      <a class="button button-secondary" href={SITE.pdfPath}>Download CV <Icon name="download" /></a>
    </p>
  </div>

  <div class="views console surface">
    <div class="head">
      <fieldset class="seg">
        <legend class="sr-only">Choose a view</legend>
        {
          VIEWS.map((v, i) => (
            <>
              <input class="sr-only" type="radio" name="hero-view" id={`view-${v.id}`} checked={i === 0} />
              <label for={`view-${v.id}`}>{v.label}</label>
            </>
          ))
        }
      </fieldset>
    </div>
    <div class="panel">
      <div class="view" data-view="map"><MapView /></div>
      <div class="view" data-view="ask"><AskView /></div>
      <div class="view" data-view="reel"><ReelView /></div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: center;
    padding-top: 48px;
    padding-bottom: 32px;
  }
  h1 {
    font-size: clamp(40px, 5.5vw, 60px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
  }
  .headline {
    font-size: 20px;
    line-height: 1.4;
    margin: 0 0 16px;
  }
  .intro {
    max-width: 36rem;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-2);
    margin: 0 0 32px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
  }
  .console {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow-float), var(--highlight);
  }
  .head {
    display: flex;
    align-items: center;
    height: 52px;
    padding: 0 12px;
    border-bottom: 1px solid var(--line);
  }
  .seg {
    display: inline-flex;
    gap: 4px;
    margin: 0;
    padding: 4px;
    border: 0;
    border-radius: 10px;
    background: var(--raised);
  }
  .seg label {
    padding: 4px 16px;
    border-radius: 6px;
    font-size: 13px;
    line-height: 20px;
    color: var(--text-2);
    cursor: pointer;
    transition: color var(--fast) var(--ease), background-color var(--fast) var(--ease);
  }
  .seg label:hover {
    color: var(--text);
  }
  .seg input:checked + label {
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 0 0 1px var(--line);
  }
  .seg input:focus-visible + label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .panel {
    display: grid;
    min-height: 400px;
  }
  .view {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transition: opacity var(--fast) var(--ease), visibility var(--fast) var(--ease);
  }
  .views:has(#view-map:checked) [data-view='map'],
  .views:has(#view-ask:checked) [data-view='ask'],
  .views:has(#view-reel:checked) [data-view='reel'] {
    visibility: visible;
    opacity: 1;
  }
  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 16px;
    }
  }
</style>
