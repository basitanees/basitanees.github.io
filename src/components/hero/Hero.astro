---
import { SITE } from '../../data/site';
import Icon from '../Icon.astro';
import KnowledgeGraph from '../graph/KnowledgeGraph.astro';
import AskView from './AskView.astro';
import ReelView from './ReelView.astro';

const VIEWS = [
  { id: 'map', label: 'Map' },
  { id: 'ask', label: 'Ask' },
  { id: 'reel', label: 'Reel' },
];
---
<section class="hero">
  <div class="inner wrap">
    <div class="text">
      <h1>{SITE.name}</h1>
      <p class="headline">{SITE.headline}</p>
      <p class="intro">
        I build the retrieval and agent systems that LLMs read from and act through, and I benchmark every retrieval change before it ships. My research is on
        generative models, published at SIGGRAPH Asia and in ACM Transactions on Graphics.
      </p>
      <dl class="proof">
        {
          SITE.proof.map(([label, value]) => (
            <>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </>
          ))
        }
      </dl>
      <p class="actions">
        <a class="button button-primary" href="/work/">View work <Icon name="arrow-right" /></a>
        <a class="button button-secondary" href={SITE.pdfPath}>Download CV <Icon name="download" /></a>
        <a class="button button-secondary" href="/contact/">Contact</a>
      </p>
    </div>
  </div>
  <div class="fade" aria-hidden="true"></div>
  <div class="views">
    <div class="head">
      <fieldset class="seg">
        <legend class="sr-only">Choose a view</legend>
        {
          VIEWS.map((v, i) => (
            <>
              <input class="sr-only" type="radio" name="hero-view" id={`view-${v.id}`} checked={i === 0} />
              <label for={`view-${v.id}`}>{v.label}</label>
            </>
          ))
        }
      </fieldset>
    </div>
    <div class="panel">
      <div class="view" data-view="map"><KnowledgeGraph bleed /></div>
      <div class="view boxed surface" data-view="ask"><AskView /></div>
      <div class="view boxed surface" data-view="reel"><ReelView /></div>
    </div>
  </div>
</section>

<style>
  /* The graph fills the whole hero on the page background; the text sits on top, lined up with the rest of the page. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(640px, 84vh, 880px);
  }
  .inner {
    position: relative;
    z-index: 2;
    padding-top: 48px;
    padding-bottom: 48px;
    pointer-events: none;
  }
  .text {
    max-width: 470px;
    pointer-events: auto;
  }
  .fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, var(--bg) 0, var(--bg) calc(50% - 260px), transparent calc(50% - 20px));
  }
  .views {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  h1 {
    font-size: clamp(40px, 5.5vw, 60px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
  }
  .headline {
    font-size: 20px;
    line-height: 1.4;
    margin: 0 0 16px;
  }
  .intro {
    max-width: 36rem;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-2);
    margin: 0 0 24px;
  }
  .proof {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
    margin: 0 0 28px;
    font-size: 14px;
  }
  .proof dt {
    color: var(--muted);
  }
  .proof dd {
    margin: 0;
    color: var(--text);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
  }
  .head {
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    z-index: 3;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: flex-end;
    pointer-events: none;
  }
  .seg {
    pointer-events: auto;
  }
  .seg {
    display: inline-flex;
    gap: 4px;
    margin: 0;
    padding: 4px;
    border: 0;
    border-radius: 10px;
    background: var(--raised);
  }
  .seg label {
    padding: 4px 16px;
    border-radius: 6px;
    font-size: 13px;
    line-height: 20px;
    color: var(--text-2);
    cursor: pointer;
    transition: color var(--fast) var(--ease), background-color var(--fast) var(--ease);
  }
  .seg label:hover {
    color: var(--text);
  }
  .seg input:checked + label {
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 0 0 1px var(--line);
  }
  .seg input:focus-visible + label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .panel {
    position: absolute;
    inset: 0;
    display: grid;
  }
  [data-view='map'] {
    height: 100%;
  }
  .boxed {
    align-self: center;
    justify-self: end;
    --inset: max(24px, calc((100% - 1120px) / 2 + 24px));
    /* Narrower, and never left of the page centre, so it stays clear of the text. */
    width: min(520px, calc(50% - var(--inset) - 16px));
    margin-right: var(--inset);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow-float), var(--highlight);
  }
  .view {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transition: opacity var(--fast) var(--ease), visibility var(--fast) var(--ease);
  }
  .views:has(#view-map:checked) [data-view='map'],
  .views:has(#view-ask:checked) [data-view='ask'],
  .views:has(#view-reel:checked) [data-view='reel'] {
    visibility: visible;
    opacity: 1;
  }
  @media (max-width: 960px) {
    .hero {
      display: block;
      min-height: 0;
    }
    .inner {
      padding-top: 16px;
      padding-bottom: 32px;
    }
    .text {
      max-width: none;
    }
    .fade {
      display: none;
    }
    .views,
    .head,
    .panel {
      position: relative;
      inset: auto;
    }
    .views {
      margin: 0 auto;
      max-width: 1120px;
      padding: 0 24px;
    }
    .head {
      top: 0;
      padding: 0 0 12px;
      justify-content: flex-start;
    }
    .panel {
      height: clamp(520px, 70vh, 640px);
    }
    .boxed {
      width: 100%;
      margin: 0;
      align-self: start;
    }
  }
  @media (max-width: 640px) {
    .panel {
      height: auto;
    }
  }
</style>
