---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import source from '../../assets/reel-source.webp';
import blonde from '../../assets/reel-blonde.webp';

const results = [
  { name: 'Noodle Lab', meta: '6 min walk' },
  { name: 'Broth & Bowl', meta: '11 min walk' },
  { name: 'A sushi place', meta: 'nice try' },
];
const tasks = ['Read the repo', 'Find the bug', 'Write the fix', 'Run the tests'];
const labels = ['Search', 'Agents', 'Knowledge graphs', 'Generative models'];
---
<div class="reel">
  <div class="screen">
    <div class="scene s1">
      <p class="lbl">Search</p>
      <p class="q">› best ramen within walking distance</p>
      <ol class="results">
        {
          results.map((r, i) => (
            <li class:list={{ top: i === 0 }}>
              <span class="rank">{String(i + 1).padStart(2, '0')}</span>
              <span class="name">{r.name}</span>
              <span class="meta">{r.meta}</span>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="scene s2">
      <p class="lbl">Agents</p>
      <ul class="tasks">
        {
          tasks.map((t) => (
            <li>
              <Icon name="check" />
              {t}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="scene s3">
      <p class="lbl">Knowledge graphs</p>
      <svg class="kg" viewBox="0 0 400 130" role="img" aria-label="A small graph linking Marie Curie, Pierre Curie, the Nobel Prize, Physics and Chemistry">
        <line x1="70" y1="40" x2="200" y2="65"></line><line x1="200" y1="65" x2="330" y2="35"></line>
        <line x1="200" y1="65" x2="300" y2="110"></line><line x1="70" y1="40" x2="110" y2="110"></line>
        <circle cx="70" cy="40" r="6"></circle><circle class="hub" cx="200" cy="65" r="8"></circle><circle cx="330" cy="35" r="6"></circle>
        <circle cx="300" cy="110" r="6"></circle><circle cx="110" cy="110" r="6"></circle>
        <text x="70" y="24" text-anchor="middle">Marie Curie</text><text x="200" y="90" text-anchor="middle">Nobel Prize</text>
        <text x="330" y="19" text-anchor="middle">Physics</text><text x="300" y="128" text-anchor="middle">Chemistry</text>
        <text x="110" y="128" text-anchor="middle">Pierre Curie</text>
      </svg>
    </div>
    <div class="scene s4">
      <p class="lbl">Generative models</p>
      <div class="edit">
        <Image src={source} width={96} height={96} densities={[1, 2]} alt="A real portrait before editing" />
        <span class="prompt">
          <span class="rank">"blonde hair"</span>
          <Icon name="arrow-right" />
        </span>
        <Image src={blonde} width={96} height={96} densities={[1, 2]} alt="The same portrait after HyperGAN-CLIP edits it from the text blonde hair" />
      </div>
      <p class="credit">From HyperGAN-CLIP</p>
    </div>
  </div>
  <p class="steps" aria-hidden="true">{labels.map((l, i) => <span class={`step d${i + 1}`}>{l}</span>)}</p>
</div>

<style>
  .reel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    height: 100%;
    padding: 24px;
  }
  .screen {
    width: min(440px, 100%);
    min-height: 232px;
    display: grid;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .scene {
    grid-area: 1 / 1;
    padding: 20px 24px;
    opacity: 0;
    animation: scene 12s var(--ease) infinite;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .scene p {
    margin: 0;
  }
  .s2 {
    animation-delay: 3s;
  }
  .s3 {
    animation-delay: 6s;
  }
  .s4 {
    animation-delay: 9s;
  }
  @keyframes scene {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }
    4%,
    22% {
      opacity: 1;
      transform: none;
    }
    26%,
    100% {
      opacity: 0;
      transform: none;
    }
  }
  .lbl {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 12px !important;
  }
  .q {
    font-family: var(--mono);
    font-size: 13px;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--raised);
    margin-bottom: 8px !important;
  }
  .results,
  .tasks {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .results li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 6px 12px;
    font-size: 14px;
  }
  .results .meta {
    margin-left: auto;
    font-size: 13px;
    color: var(--muted);
  }
  .results .top .name {
    color: var(--accent);
  }
  .tasks li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 0;
    font-size: 14px;
  }
  .tasks :global(.icon) {
    color: var(--positive);
  }
  .kg {
    width: 100%;
    height: 132px;
  }
  .kg line {
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .kg circle {
    fill: var(--surface);
    stroke: var(--muted);
  }
  .kg .hub {
    stroke: var(--accent);
  }
  .kg text {
    fill: var(--text-2);
    font-size: 11px;
    font-family: var(--font);
  }
  .edit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .edit :global(img) {
    border-radius: 8px;
    display: block;
  }
  .prompt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: var(--muted);
  }
  .credit {
    margin-top: 12px !important;
    text-align: center;
    font-size: 12px;
    color: var(--muted);
  }
  .steps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 16px;
    margin: 0;
    font-size: 12px;
  }
  .step {
    color: var(--muted);
    animation: step 12s var(--ease) infinite;
  }
  .d2 {
    animation-delay: 3s;
  }
  .d3 {
    animation-delay: 6s;
  }
  .d4 {
    animation-delay: 9s;
  }
  @keyframes step {
    0%,
    24% {
      color: var(--text);
    }
    26%,
    100% {
      color: var(--muted);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .screen {
      width: 100%;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
      background: none;
      border: 0;
      gap: 8px;
    }
    .scene {
      grid-area: auto;
      opacity: 1;
      padding: 12px;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: var(--bg);
    }
    .steps {
      display: none;
    }
  }
</style>
