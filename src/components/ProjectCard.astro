---
import AreaChips from './AreaChips.astro';
import Icon from './Icon.astro';
import { formatDates, projectHref, type P } from '../lib/projects';

interface Props {
  project: P;
  rank?: number;
}
const { project, rank } = Astro.props;
const { title, org, start, end, summary, areas, links } = project.data;
const href = projectHref(project);
const meta = [org, formatDates(start, end)].filter(Boolean).join(' · ');
---
<article class="card surface" data-project={project.id}>
  <p class="top">
    {rank !== undefined && <span class="rank">{String(rank).padStart(2, '0')}</span>}
    <span class="meta">{meta}</span>
  </p>
  <h3>{href ? <a href={href}>{title}</a> : title}</h3>
  <p class="summary">{summary}</p>
  <div class="foot">
    <AreaChips areas={areas} small />
    {
      links.length > 0 && (
        <p class="links">
          {links.map((l) => (
            <a href={l.href}>
              {l.label}
              <Icon name="arrow-up-right" size={14} />
            </a>
          ))}
        </p>
      )
    }
  </div>
</article>

<style>
  .card {
    border-radius: 16px;
    padding: 24px 28px;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    grid-template-areas: 'top summary' 'title summary' 'foot summary';
    grid-template-rows: auto auto 1fr;
    gap: 8px 48px;
    transition: border-color var(--fast) var(--ease);
  }
  .card:has(h3 a:hover) {
    border-color: var(--line-strong);
  }
  .top {
    grid-area: top;
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 13px;
    color: var(--muted);
  }
  h3 {
    grid-area: title;
    margin: 4px 0 0;
    font-size: 18px;
  }
  h3 a {
    color: var(--text);
  }
  .summary {
    grid-area: summary;
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .foot {
    grid-area: foot;
    align-self: end;
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .links {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-size: 14px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  @media (max-width: 760px) {
    .card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'top' 'title' 'summary' 'foot';
      grid-template-rows: auto;
    }
  }
</style>
